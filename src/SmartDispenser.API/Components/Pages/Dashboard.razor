@page "/dashboard"
@rendermode InteractiveServer
@using SmartDispenser.API.SignalR
@implements IDisposable
@inject IDispenserRepository DispenserRepository
@inject DispenserNotifier Notifier

<PageTitle>SmartDispenser Dashboard</PageTitle>

<div class="dashboard-header">
    <h1>Machine Dashboard</h1>
    <p class="subtitle">
        @_machines.Values.Count(m => m.IsOnline) of @_machines.Count machines online &bull;
        Last updated: @_lastUpdated.ToString("HH:mm:ss")
    </p>
</div>

@if (_machines.Count == 0)
{
    <div class="empty-state">
        <p>No machines registered yet. Register one with <code>POST /api/dispensers</code>.</p>
    </div>
}
else
{
    <div class="machine-grid">
        @foreach (var machine in _machines.Values.OrderBy(m => m.Name))
        {
            <div class="machine-card @StatusClass(machine.Status)">
                <div class="machine-header">
                    <span class="machine-name">@machine.Name</span>
                    <span class="status-badge @StatusClass(machine.Status)">@StatusLabel(machine.Status)</span>
                </div>
                <div class="machine-location">@machine.Location &bull; @machine.Medication</div>
                <div class="inventory-bar-container">
                    <div class="inventory-label">
                        <span>Inventory</span>
                        <span>@machine.InventoryCount / @machine.InventoryCapacity</span>
                    </div>
                    <div class="inventory-bar">
                        <div class="inventory-fill @InventoryClass(machine.InventoryPercentage)"
                             style="width: @(machine.InventoryPercentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                        </div>
                    </div>
                </div>
                <div class="machine-meta">
                    @if (machine.LastDispenseAt is { } lastDispense)
                    {
                        <span>Last dispense @FormatRelative(lastDispense)</span>
                    }
                    @if (machine.FirmwareVersion is not null)
                    {
                        <span>Firmware @machine.FirmwareVersion</span>
                    }
                </div>
            </div>
        }
    </div>
}

@if (_events.Count > 0)
{
    <div class="event-feed">
        <h2>Live Event Feed</h2>
        <div class="event-list">
            @foreach (var evt in _events)
            {
                <div class="event-item @evt.Kind">
                    <span class="event-time">@evt.At.ToString("HH:mm:ss")</span>
                    <span class="event-message">@evt.Message</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private const int MaxEvents = 10;

    private readonly Dictionary<Guid, DispenserStateDto> _machines = [];
    private readonly List<DashboardEvent> _events = [];
    private DateTimeOffset _lastUpdated = DateTimeOffset.UtcNow;

    protected override async Task OnInitializedAsync()
    {
        foreach (var dispenser in await DispenserRepository.GetAllAsync())
            _machines[dispenser.Id] = DispenserStateDto.From(dispenser);

        Notifier.StateChanged += OnStateChanged;
        Notifier.DispenseResultPublished += OnDispenseResult;
    }

    private void OnStateChanged(DispenserStateDto state) => InvokeAsync(() =>
    {
        _machines[state.Id] = state;
        AddEvent(state.IsOnline ? "info" : "offline",
            $"{state.Name}: {state.Status} (inventory {state.InventoryCount}/{state.InventoryCapacity})");
    });

    private void OnDispenseResult(DispenseResultNotification result) => InvokeAsync(() =>
        AddEvent(result.Success ? "success" : "error", result.Success
            ? $"Dispense {result.RequestId.ToString()[..8]} completed"
            : $"Dispense {result.RequestId.ToString()[..8]} failed: {result.ErrorMessage}"));

    private void AddEvent(string kind, string message)
    {
        _lastUpdated = DateTimeOffset.UtcNow;
        _events.Insert(0, new(kind, _lastUpdated, message));
        if (_events.Count > MaxEvents)
            _events.RemoveAt(MaxEvents);
        StateHasChanged();
    }

    private static string StatusClass(string status) => status switch
    {
        "Idle" => "status-idle",
        "Dispensing" => "status-dispensing",
        "Error" => "status-error",
        "InventoryEmpty" => "status-empty",
        _ => "status-offline",
    };

    private static string StatusLabel(string status) => status == "InventoryEmpty" ? "Out of stock" : status;

    private static string InventoryClass(double pct) => pct switch
    {
        > 50 => "inventory-good",
        > 20 => "inventory-warn",
        _ => "inventory-low",
    };

    private static string FormatRelative(DateTimeOffset at)
    {
        var elapsed = DateTimeOffset.UtcNow - at;
        return elapsed.TotalMinutes < 1 ? $"{(int)elapsed.TotalSeconds}s ago"
             : elapsed.TotalHours < 1 ? $"{(int)elapsed.TotalMinutes}m ago"
             : $"{(int)elapsed.TotalHours}h ago";
    }

    public void Dispose()
    {
        Notifier.StateChanged -= OnStateChanged;
        Notifier.DispenseResultPublished -= OnDispenseResult;
    }

    private sealed record DashboardEvent(string Kind, DateTimeOffset At, string Message);
}
