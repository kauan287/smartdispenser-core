# HMAC-SHA256 key shared with the payment gateway. At least 32 characters.
WEBHOOK_SECRET=change-me-to-a-random-secret-of-32-plus-chars

# HealthTech Agent Orchestrator, as reachable from inside the api container.
# The default reaches an orchestrator running on the host at port 8000.
HEALTHTECH_API_URL=http://host.docker.internal:8000
