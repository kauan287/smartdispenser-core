# ── Required ──────────────────────────────────────────────────────────────────
# Must be 32+ characters — used for HMAC-SHA256 webhook validation
WEBHOOK_SECRET=your-webhook-secret-at-least-32-chars

# ── Optional overrides ────────────────────────────────────────────────────────
# URL of the HealthTech Agent Orchestrator (Project 1)
# Defaults to http://localhost:8000 for local dev
HEALTHTECH_API_URL=http://localhost:8000

# Postgres connection (only needed if not using docker compose defaults)
# DATABASE_URL=Host=localhost;Port=5433;Database=smartdispenser;Username=smartdispenser;Password=smartdispenser
